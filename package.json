{
  "name": "unit-testing-in-javascript",
  "version": "1.0.0",
  "description": "some basic unit testing with Jest in JS for conceptualise, essentially.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "jest",
    "watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tasin7898/Unit-Testing-in-JavaScript.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tasin7898/Unit-Testing-in-JavaScript/issues"
  },
  "homepage": "https://github.com/tasin7898/Unit-Testing-in-JavaScript#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.4.1",
    "css-loader": "^7.1.4",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  }
